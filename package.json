{
  "name": "championship-chess-director",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && node --enable-source-maps dist/server.js",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "screenshots:providers": "playwright test --grep @review-captures"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
